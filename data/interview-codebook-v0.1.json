        { "code": "guide_combo", "ko": "코·이마만 번들거리고 볼은 건조하다", "ja": "鼻・額だけテカり、頬は乾燥する", "maps_to": "skin_combo" },
        { "code": "guide_dry", "ko": "유분은 거의 없고 들뜨거나 각질이 생긴다", "ja": "皮脂はほとんどなく、粉をふく", "maps_to": "skin_dry" },
