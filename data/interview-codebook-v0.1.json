  "order": {
    "pre_offer": ["trigger", "concern_codes", "skin_guide_answer", "current_status", "dissatisfaction", "decision_factors", "primary_concern_code", "budget_band", "ai_service", "ai_question_raw", "ai_candidates_raw", "verify_channels", "intent_scale", "leading_candidate_raw", "planned_channel"],
    "post_offer": ["outcome", "chosen_product_raw", "reason_codes", "changed_after_offer"]
  },
  "limits": { "max_turns": { "pre_offer": 18, "post_offer": 6 }, "max_probes_per_slot": 1 }
}
